---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { loadCatalog, type RegistryEntry } from "@/lib/catalog";
import { withBase } from "@/lib/urls";

export async function getStaticPaths() {
  const entries = await loadCatalog();
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props { entry: RegistryEntry }
const { entry } = Astro.props;
const repositoryPath = new URL(entry.source_url).pathname.replace(/^\//, "");
const repositoryName = repositoryPath.split("/").at(-1) ?? entry.slug;
const defaultClone = `git clone ${entry.source_url}.git`;
const qualityLabel = { verified: "已验证", community: "社区收录", experimental: "实验性" }[entry.quality];
---

<BaseLayout title={`${entry.name} — 仓颉 Skill`} description={entry.summary}>
  <section class="detail-hero"><div class="shell"><a class="back-link" href={withBase("/skills")}>← 返回 Skills 目录</a><div class="detail-heading"><div><div class="detail-badges"><span class:list={["quality-badge", `quality-${entry.quality}`]}>{qualityLabel}</span><span>{entry.skill_count} 个原子 Skill</span></div><h1>{entry.name}</h1><p>{entry.summary}</p></div><a class="button" href={entry.source_url} target="_blank" rel="noreferrer">在 GitHub 查看 ↗</a></div></div></section>

  <div class="shell detail-grid">
    <article class="prose detail-content">
      <section><p class="eyebrow">Use cases</p><h2>它适合解决什么问题</h2><ul class="use-case-list">{entry.use_cases.map((useCase) => <li>{useCase}</li>)}</ul></section>
      <section><p class="eyebrow">Install</p><h2>安装这个 Skill Pack</h2><p>克隆仓库，然后将需要的 Skill 文件夹复制到你的 Agent Skills 目录。安装前建议先阅读仓库 README 和各个 <code>SKILL.md</code>。</p><div class="command-block"><code>{entry.install?.clone ?? defaultClone}</code><button type="button" data-copy={entry.install?.clone ?? defaultClone}>复制</button></div><pre><code>mkdir -p ~/.codex/skills
cp -R {repositoryName} ~/.codex/skills/</code></pre><p class="install-note">不同 Agent 的目录位置可能不同，详见 <a href={withBase("/learn#install")}>完整安装教程</a>。</p></section>
      <section><p class="eyebrow">Try it</p><h2>开始一次真实调用</h2><div class="callout">请使用「{entry.name}」中最适合的方法处理我的任务。开始前，先说明你选择了哪个原子 Skill，以及它要求遵循的步骤。</div></section>
    </article>

    <aside class="metadata-panel"><h2>Registry 信息</h2><dl><div><dt>Slug</dt><dd><code>{entry.slug}</code></dd></div><div><dt>领域</dt><dd>{entry.domains.join("、")}</dd></div><div><dt>语言</dt><dd>{entry.language.join(" / ")}</dd></div><div><dt>来源类型</dt><dd>{entry.source_type === "github" ? "GitHub 仓库" : "仓库内置"}</dd></div><div><dt>维护者 / 仓库</dt><dd><a href={entry.source_url} target="_blank" rel="noreferrer">{repositoryPath} ↗</a></dd></div><div><dt>状态</dt><dd>{entry.status}</dd></div></dl><p>信息有误或需要更新？请通过 GitHub Pull Request 修改对应的 <code>registry/{entry.slug}/entry.yaml</code>。</p></aside>
  </div>

  <script>
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
      button.addEventListener("click", async () => {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        const original = button.textContent;
        button.textContent = "已复制";
        setTimeout(() => { button.textContent = original; }, 1400);
      });
    });
  </script>
</BaseLayout>

<style>
  .detail-hero { padding: 46px 0 54px; border-bottom: 1px solid var(--line); background: var(--soft); }
  .back-link { color: var(--muted); font-size: 13px; }
  .back-link:hover { color: var(--accent); }
  .detail-heading { display: flex; justify-content: space-between; align-items: end; gap: 36px; margin-top: 48px; }
  .detail-heading h1 { margin: 18px 0 12px; max-width: 800px; font-size: clamp(40px, 6vw, 66px); line-height: 1.05; letter-spacing: -.045em; }
  .detail-heading p { max-width: 720px; margin: 0; color: var(--muted); font-size: 18px; }
  .detail-badges { display: flex; align-items: center; gap: 12px; color: var(--muted); font-size: 12px; }
  .detail-grid { display: grid; grid-template-columns: minmax(0, 720px) 300px; justify-content: space-between; gap: 70px; padding-top: 20px; }
  .detail-content section { padding: 42px 0 52px; }
  .detail-content section + section { border-top: 1px solid var(--line); }
  .detail-content h2 { margin-top: 0; }
  .use-case-list { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 0; list-style: none; }
  .use-case-list li { padding: 16px; border: 1px solid var(--line); border-radius: 7px; color: var(--ink); }
  .use-case-list li::before { content: "✓"; margin-right: 9px; color: var(--success); }
  .command-block { display: flex; margin: 20px 0 12px; border-radius: 8px; background: #20211e; }
  .command-block code { flex: 1; overflow-x: auto; padding: 17px; color: white; font: 13px "SFMono-Regular", monospace; white-space: nowrap; }
  .command-block button { border: 0; border-left: 1px solid #454740; padding: 0 16px; background: transparent; color: #c9cbc3; }
  .install-note { font-size: 14px; }
  .metadata-panel { position: sticky; top: 96px; align-self: start; margin-top: 42px; padding: 22px; border: 1px solid var(--line); border-radius: 8px; }
  .metadata-panel h2 { margin: 0 0 12px; font-size: 16px; }
  .metadata-panel dl { margin: 0; }
  .metadata-panel dl div { padding: 13px 0; border-top: 1px solid var(--line); }
  .metadata-panel dt { color: var(--muted); font-size: 11px; }
  .metadata-panel dd { margin: 4px 0 0; overflow-wrap: anywhere; font-size: 13px; }
  .metadata-panel a { color: var(--accent); }
  .metadata-panel > p { margin: 20px 0 0; color: var(--muted); font-size: 12px; }
  @media (max-width: 820px) { .detail-heading { align-items: flex-start; flex-direction: column; } .detail-grid { grid-template-columns: 1fr; gap: 0; } .metadata-panel { position: static; order: -1; margin-top: 32px; } }
  @media (max-width: 560px) { .use-case-list { grid-template-columns: 1fr; } }
</style>
